{
	"name": "openstaticeditor",
	"version": "1.0.0",
	"description": "Vue3 + Pinia + Electron 桌面应用",
	"author": "Azrael",
	"license": "MIT",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
		"build": "vue-tsc --noEmit && env -u ELECTRON_RUN_AS_NODE electron-vite build",
		"type-check": "vue-tsc --noEmit",
		"preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
		"package": "env -u ELECTRON_RUN_AS_NODE electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder",
		"dist": "env -u ELECTRON_RUN_AS_NODE electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder",
		"dist:win": "env -u ELECTRON_RUN_AS_NODE electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder --win",
		"dist:mac": "env -u ELECTRON_RUN_AS_NODE electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
		"format": "prettier --write \"**/*.{js,ts,json}\"",
		"format:check": "prettier --check \"**/*.{js,ts,json}\""
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^3.0.0",
		"ant-design-vue": "^4.2.6",
		"pinia": "^2.3.1",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.10.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"electron": "^33.3.2",
		"electron-builder": "^25.1.8",
		"electron-vite": "^2.3.0",
		"prettier": "^3.9.10",
		"prettier-plugin-vue": "^1.1.6",
		"sass": "^1.105.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.6.3",
		"vite": "^5.4.11",
		"vue-tsc": "^2.1.10"
	},
	"build": {
		"appId": "openstaticeditor",
		"productName": "OpenStaticEditor",
		"copyright": "Copyright © 2026 Let's UFO",
		"directories": {
			"output": "release/${version}"
		},
		"files": [
			"out/**/*"
		],
		"mac": {
			"target": [
				"dmg"
			],
			"artifactName": "${productName}-${version}-mac.${ext}"
		},
		"win": {
			"target": [
				"nsis"
			],
			"artifactName": "${productName}-${version}-setup.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true
		}
	}
}
